generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model Account {
  account_id            BigInt                           @id @default(autoincrement())
  phone                 String                           @unique
  email                 String
  password              String?
  role                  Role
  created_at            DateTime                         @db.Timestamp(0)
  account_status        AccountStatus                    @default(Active)
  supabase_user_id      String?                          @unique @db.Uuid
  email_verified_at     DateTime?                        @db.Timestamp(0)
  activationOtps        account_activation_otp[]
  emailVerificationOtps account_email_verification_otp[]
  businessOwner         businessOwner?
  hubStaff              hub_staff?
  leeoAdmin             leeo_admin?
  vendor                vendor?

  @@schema("public")
}

model businessOwner {
  business_owner_id BigInt     @id @default(autoincrement())
  account_id        BigInt     @unique
  first_name        String
  last_name         String
  contact_number    String
  email             String
  created_at        DateTime   @db.Timestamp(0)
  businesses        business[]
  account           Account    @relation(fields: [account_id], references: [account_id])

  @@schema("public")
}

model business {
  business_id       BigInt        @id @default(autoincrement())
  business_owner_id BigInt
  stall_id          BigInt
  business_name     String
  business_type     BusinessType
  lease_date        String
  owner             businessOwner @relation(fields: [business_owner_id], references: [business_owner_id])
  products          product[]
  active_in_stalls  stall[]       @relation("stall_active_business")
  vendors           vendor[]

  @@index([business_owner_id])
  @@index([stall_id])
  @@schema("public")
}

model stall {
  stall_id           BigInt      @id @default(autoincrement())
  name               String
  stall_number       Int
  stall_width        Float
  stall_height       Float
  monthly_rent       Float
  rent_status        RentStatus
  active_business_id BigInt
  active_business    business    @relation("stall_active_business", fields: [active_business_id], references: [business_id])
  violations         violation[]

  @@index([active_business_id])
  @@schema("public")
}

model vendor {
  vendor_id      BigInt   @id @default(autoincrement())
  account_id     BigInt   @unique
  business_id    BigInt
  first_name     String
  last_name      String
  contact_number String
  created_at     DateTime @db.Timestamp(0)
  account        Account  @relation(fields: [account_id], references: [account_id])
  business       business @relation(fields: [business_id], references: [business_id])

  @@index([business_id])
  @@schema("public")
}

model zone {
  zone_id      BigInt @id @default(autoincrement())
  name         String
  no_of_stalls Int

  @@index([name])
  @@schema("public")
}

model violation {
  violation_id BigInt @id @default(autoincrement())
  stall_id     BigInt
  interest     Float
  stall        stall  @relation(fields: [stall_id], references: [stall_id])

  @@index([stall_id])
  @@schema("public")
}

model transactions {
  transaction_id    BigInt              @id @default(autoincrement())
  owner_id          BigInt
  sale_datetime     DateTime            @db.Timestamp(0)
  total_amount      Float               @db.Real
  external_id       String
  paid_amount       Float?              @db.Real
  transaction_items transaction_items[]
  user              users               @relation(fields: [owner_id], references: [id])

  @@unique([owner_id, external_id])
  @@index([owner_id])
  @@schema("public")
}

model product {
  product_id  BigInt   @id @default(autoincrement())
  name        String
  price       Float
  business_id BigInt
  tarrif_id   BigInt
  business    business @relation(fields: [business_id], references: [business_id])
  tariff      tarrif   @relation(fields: [tarrif_id], references: [tarrif_id])

  @@index([name])
  @@schema("public")
}

model tarrif {
  tarrif_id   BigInt    @id @default(autoincrement())
  name        String
  tarrif_rate Float
  products    product[]

  @@index([name])
  @@schema("public")
}

model delivery_ticket_fee {
  ticket_id BigInt @id @default(autoincrement())

  @@schema("public")
}

model hub_staff {
  hubstaff_id    BigInt   @id @default(autoincrement())
  account_id     BigInt   @unique
  first_name     String
  last_name      String
  contact_number String
  created_at     DateTime @db.Timestamp(0)
  account        Account  @relation(fields: [account_id], references: [account_id])

  @@schema("public")
}

model account_activation_otp {
  otp_id      BigInt    @id @default(autoincrement())
  account_id  BigInt
  code_hash   String
  expires_at  DateTime  @db.Timestamp(0)
  attempts    Int       @default(0)
  consumed_at DateTime? @db.Timestamp(0)
  created_at  DateTime  @db.Timestamp(0)
  account     Account   @relation(fields: [account_id], references: [account_id])

  @@index([account_id])
  @@index([expires_at])
  @@schema("public")
}

model account_email_verification_otp {
  otp_id      BigInt    @id @default(autoincrement())
  account_id  BigInt
  code_hash   String
  expires_at  DateTime  @db.Timestamp(0)
  attempts    Int       @default(0)
  consumed_at DateTime? @db.Timestamp(0)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  account     Account   @relation(fields: [account_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id], map: "idx_account_email_verification_otp_account_id")
  @@index([expires_at], map: "idx_account_email_verification_otp_expires_at")
  @@schema("public")
}

model queueing_ticket {
  ticket_id       BigInt   @id @default(autoincrement())
  vehicle_type    String
  time_of_arrival DateTime @db.Timestamp(0)
  waiting_time    Int
  status          String
  issued_by       BigInt

  @@schema("public")
}

model sync_queue_record {
  id                   String                  @id @db.Uuid
  queue_number         String
  arrival_time         DateTime                @db.Timestamptz(6)
  vehicle_type         String
  product_category     String
  record_date          DateTime                @db.Date
  created_at           DateTime                @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                @default(now()) @db.Timestamptz(6)
  deleted_at           DateTime?               @db.Timestamptz(6)
  version              Int                     @default(1)
  source_device_id     String?
  last_idempotency_key String?
  sync_status          String?
  ticketRecords        sync_ticket_record[]
  unloadingRecords     sync_unloading_record[]

  @@index([updated_at(sort: Desc)], map: "idx_sync_queue_updated_at")
  @@schema("public")
}

model sync_unloading_record {
  id                   String            @id @db.Uuid
  queue_record_id      String            @db.Uuid
  queue_number         String
  vehicle_number       String
  vehicle_type         String
  product_category     String
  started_at           DateTime          @db.Timestamptz(6)
  estimated_minutes    Int
  completed_at         DateTime?         @db.Timestamptz(6)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at           DateTime?         @db.Timestamptz(6)
  version              Int               @default(1)
  source_device_id     String?
  last_idempotency_key String?
  sync_status          String?
  queueRecord          sync_queue_record @relation(fields: [queue_record_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([queue_record_id], map: "idx_sync_unloading_queue_record_id")
  @@index([updated_at(sort: Desc)], map: "idx_sync_unloading_updated_at")
  @@schema("public")
}

model sync_ticket_record {
  id                       String            @id @db.Uuid
  queue_record_id          String            @db.Uuid
  transaction_id           String            @unique(map: "idx_sync_ticket_transaction_id")
  ticket_no                String
  vehicle_number           String
  vehicle_type             String
  goods_type               String
  unloading_time           DateTime          @db.Timestamptz(6)
  suggested_unloading_time DateTime          @db.Timestamptz(6)
  total_amount             Decimal           @db.Decimal(14, 2)
  issued_at                DateTime          @db.Timestamptz(6)
  items                    Json              @default("[]")
  created_at               DateTime          @default(now()) @db.Timestamptz(6)
  updated_at               DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at               DateTime?         @db.Timestamptz(6)
  version                  Int               @default(1)
  source_device_id         String?
  last_idempotency_key     String?
  sync_status              String?
  queueRecord              sync_queue_record @relation(fields: [queue_record_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([queue_record_id], map: "idx_sync_ticket_queue_record_id")
  @@index([updated_at(sort: Desc)], map: "idx_sync_ticket_updated_at")
  @@schema("public")
}

model sync_idempotency_ledger {
  id               BigInt   @id @default(autoincrement())
  idempotency_key  String
  entity_type      String
  operation        String
  entity_id        String
  request_hash     String
  response_status  Int
  response_payload Json
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([idempotency_key, entity_type, operation])
  @@index([entity_type, operation, entity_id], map: "idx_sync_idempotency_lookup")
  @@schema("public")
}

model leeo_admin {
  admin_id       BigInt        @id @default(autoincrement())
  account_id     BigInt        @unique
  first_name     String
  last_name      String
  admin_role     AdminRole
  contact_number String
  created_at     DateTime      @db.Timestamp(0)
  account_status AccountStatus
  account        Account       @relation(fields: [account_id], references: [account_id])

  @@schema("public")
}

model users {
  id           BigInt         @id @default(autoincrement())
  name         String
  transactions transactions[]

  @@schema("public")
}

