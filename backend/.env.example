DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

PORT=3000
ADMIN_FRONTEND_URL="http://localhost:8081"
ALLOW_INSECURE_DB_SSL=false
AUTH_GUARD_ENABLED=false
AUTH_GUARD_TOKEN=""
TX_SYNC_DEBUG=false

# Add these only when enabling Supabase Auth in backend routes.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"