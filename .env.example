# Optional development overrides. Android release builds use the tracked public
# client configuration when these values are absent.
# Never put SUPABASE_SERVICE_ROLE_KEY, sb_secret_* keys, or other secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
